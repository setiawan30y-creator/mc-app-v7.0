@push('scripts')
<script>
    function openThresholdModal(type, id = null) {
        let modalId;

        if (type === 'create') {
            modalId = 'createThresholdModal';
        } else {
            modalId = 'editThresholdModal' + id;
        }

        const modal = document.getElementById(modalId);

        if (!modal) {
            return;
        }

        modal.classList.add('show');
        document.body.style.overflow = 'hidden';
    }


    function closeThresholdModal(type, id = null) {
        let modalId;

        if (type === 'create') {
            modalId = 'createThresholdModal';
        } else {
            modalId = 'editThresholdModal' + id;
        }

        const modal = document.getElementById(modalId);

        if (!modal) {
            return;
        }

        modal.classList.remove('show');

        const anyOpen = document.querySelector(
            '.threshold-modal.show'
        );

        if (!anyOpen) {
            document.body.style.overflow = '';
        }
    }


    function closeThresholdModalOnBackdrop(event) {
        if (event.target !== event.currentTarget) {
            return;
        }

        const modal = event.currentTarget;

        modal.classList.remove('show');

        const anyOpen = document.querySelector(
            '.threshold-modal.show'
        );

        if (!anyOpen) {
            document.body.style.overflow = '';
        }
    }


    document.addEventListener('keydown', function(event) {

        if (event.key !== 'Escape') {
            return;
        }

        document
            .querySelectorAll('.threshold-modal.show')
            .forEach(function(modal) {

                modal.classList.remove('show');

            });

        document.body.style.overflow = '';

    });
</script>
