<script>

function initCurrencySearch() {
    const search = document.getElementById('currencySearch');
    const select = document.getElementById('currency_id');

    if (!search || !select) return;

    const countryMap = {
        IDR: 'Indonesia',
        USD: 'United States',
        SGD: 'Singapore',
        MYR: 'Malaysia',
        SAR: 'Saudi Arabia',
        AED: 'United Arab Emirates',
        EUR: 'European Union',
        GBP: 'United Kingdom',
        JPY: 'Japan',
        CNY: 'China',
        KRW: 'South Korea',
        THB: 'Thailand',
        AUD: 'Australia',
        CAD: 'Canada',
        CHF: 'Switzerland',
        NZD: 'New Zealand',
        INR: 'India',
        PHP: 'Philippines',
        VND: 'Vietnam'
    };

    Array.from(select.options).forEach(function (option) {
        const code = option.dataset.code;

        if (code && countryMap[code]) {
            option.dataset.country = countryMap[code];
        }
    });

    search.addEventListener('input', function () {
        const keyword = search.value.trim().toLowerCase();

        Array.from(select.options).forEach(function (option, index) {
            if (index === 0) {
                option.hidden = false;
                return;
            }

            const code = (option.dataset.code || '').toLowerCase();
            const name = (option.textContent || '').toLowerCase();
            const country = (option.dataset.country || '').toLowerCase();

            option.hidden = keyword !== '' &&
                !code.includes(keyword) &&
                !name.includes(keyword) &&
                !country.includes(keyword);
        });
    });
}



async function renderCurrencyFlags() {
    const countryMap = {
        USD: 'us',
        SGD: 'sg',
        MYR: 'my',
        SAR: 'sa',
        AED: 'ae',
        EUR: 'eu',
        GBP: 'gb',
        JPY: 'jp',
        CNY: 'cn',
        KRW: 'kr',
        THB: 'th',
        AUD: 'au',
        CAD: 'ca',
        CHF: 'ch',
        NZD: 'nz',
        INR: 'in',
        PHP: 'ph',
        IDR: 'id',
        VND: 'vn'
    };

    const elements =
        document.querySelectorAll(
            '.rates-flag[data-currency-flag]'
        );

    if (!elements.length) {
        return;
    }

    /*
     * Render mapping yang sudah dikenal terlebih dahulu.
     * Ini menjaga currency existing tetap seperti sekarang.
     */
    elements.forEach(function (element) {
        const currencyCode =
            String(
                element.getAttribute(
                    'data-currency-flag'
                ) || ''
            ).toUpperCase();

        const countryCode =
            countryMap[currencyCode];

        if (!countryCode) {
            return;
        }

        const img =
            document.createElement('img');

        img.className =
            'rates-flag-svg';

        img.src =
            'https://flagcdn.com/w80/' +
            countryCode +
            '.png';

        img.alt =
            currencyCode + ' flag';

        img.loading = 'lazy';
        img.decoding = 'async';

        element.innerHTML = '';
        element.appendChild(img);
    });

    /*
     * Cari currency yang belum mempunyai
     * mapping manual.
     */
    const unknownCodes =
        Array.from(elements)
            .map(function (element) {
                return String(
                    element.getAttribute(
                        'data-currency-flag'
                    ) || ''
                ).toUpperCase();
            })
            .filter(function (code, index, array) {
                return (
                    code &&
                    !countryMap[code] &&
                    array.indexOf(code) === index
                );
            });

    if (!unknownCodes.length) {
        return;
    }

    /*
     * Ambil data ISO beserta entity negaranya.
     */
    try {
        const endpoint =
            @json(route('settings.iso-currencies.index'));

        const response =
            await fetch(endpoint, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin'
            });

        if (!response.ok) {
            return;
        }

        const payload =
            await response.json();

        if (
            !payload ||
            payload.success !== true ||
            !Array.isArray(payload.data)
        ) {
            return;
        }

        const isoMap = {};

        payload.data.forEach(
            function (currency) {
                const code =
                    String(
                        currency.code || ''
                    ).toUpperCase();

                if (!code) {
                    return;
                }

                /*
                 * Ambil entity yang memiliki
                 * country_code.
                 *
                 * Untuk currency multi-entitas,
                 * kita tidak mengubah mapping existing.
                 */
                const entities =
                    Array.isArray(
                        currency.entities
                    )
                        ? currency.entities
                        : [];

                const entity =
                    entities.find(
                        function (item) {
                            return (
                                item &&
                                item.country_code
                            );
                        }
                    );

                if (
                    entity &&
                    entity.country_code
                ) {
                    isoMap[code] =
                        String(
                            entity.country_code
                        ).toLowerCase();
                }
            }
        );

        /*
         * Render currency baru berdasarkan
         * country_code dari ISO.
         */
        elements.forEach(
            function (element) {
                const currencyCode =
                    String(
                        element.getAttribute(
                            'data-currency-flag'
                        ) || ''
                    ).toUpperCase();

                if (
                    !currencyCode ||
                    countryMap[currencyCode]
                ) {
                    return;
                }

                const countryCode =
                    isoMap[currencyCode];

                if (!countryCode) {
                    return;
                }

                const img =
                    document.createElement('img');

                img.className =
                    'rates-flag-svg';

                img.src =
                    'https://flagcdn.com/w80/' +
                    countryCode +
                    '.png';

                img.alt =
                    currencyCode + ' flag';

                img.loading = 'lazy';
                img.decoding = 'async';

                element.innerHTML = '';
                element.appendChild(img);
            }
        );
    } catch (error) {
        console.warn(
            'ISO currency flag lookup gagal:',
            error
        );
    }
}

function initIsoCurrencySelector() {
    const openButton = document.getElementById('isoCurrencyOpenButton');
    const modal = document.getElementById('isoCurrencyModal');
    const closeButton = document.getElementById('isoCurrencyCloseButton');
    const backdrop = modal?.querySelector('[data-iso-close="1"]');
    const searchInput = document.getElementById('isoCurrencySearch');
    const loading = document.getElementById('isoCurrencyLoading');
    const empty = document.getElementById('isoCurrencyEmpty');
    const list = document.getElementById('isoCurrencyList');
    const currencyField = document.getElementById('currency_id');

    if (
        !openButton ||
        !modal ||
        !closeButton ||
        !searchInput ||
        !loading ||
        !empty ||
        !list ||
        !currencyField
    ) {
        return;
    }

    const endpoint = @json(route('settings.iso-currencies.index'));
    const addToMasterUrlTemplate =
        @json(route('settings.iso-currencies.add-to-master', ['isoCurrency' => '__ISO_ID__']));

    let isoCurrencies = [];
    let loaded = false;
    let loadingPromise = null;
    let addingCurrency = false;

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function normalize(value) {
        return String(value ?? '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    function getEntityText(currency) {
        return (currency.entities || [])
            .map(function (entity) {
                const country = entity.country_code
                    ? String(entity.country_code).toUpperCase() + ' — '
                    : '';

                return country + String(entity.entity_name || '');
            })
            .filter(Boolean)
            .join(' | ');
    }

    function getEntityPreview(currency) {
        const entities = currency.entities || [];

        if (!entities.length) {
            return '<span class="rates-iso-entity-empty">—</span>';
        }

        const preview = entities.slice(0, 4).map(function (entity) {
            const country = entity.country_code
                ? String(entity.country_code).toUpperCase()
                : '';

            const name = String(entity.entity_name || '');

            return (
                '<span class="rates-iso-entity-tag">' +
                    (country
                        ? '<strong>' + escapeHtml(country) + '</strong> '
                        : '') +
                    escapeHtml(name) +
                '</span>'
            );
        }).join('');

        const remaining =
            entities.length - Math.min(entities.length, 4);

        return (
            '<div class="rates-iso-entity-tags">' +
                preview +
                (
                    remaining > 0
                        ? '<span class="rates-iso-entity-more">+' +
                            remaining +
                            ' entitas lainnya</span>'
                        : ''
                ) +
            '</div>'
        );
    }

    function updateCurrencyForm(currency) {
        if (!currency) {
            return;
        }

        const master = currency.master_currency;

        if (!master || !master.is_active) {
            return;
        }

        currencyField.value = String(master.id);

        currencyField.dispatchEvent(
            new Event('change', { bubbles: true })
        );

        const currencySearch =
            document.getElementById('currencySearch');

        if (currencySearch) {
            currencySearch.value =
                currency.code + ' - ' + currency.name;
        }

        /*
         * Pastikan renderer flag utama ikut dijalankan.
         * Untuk currency yang sudah memiliki mapping flag,
         * renderer akan menampilkan flag seperti biasa.
         */
        if (typeof renderCurrencyFlags === 'function') {
            renderCurrencyFlags();
        }
    }

    async function addCurrencyToMaster(currency, button) {
        if (!currency || !currency.id || addingCurrency) {
            return;
        }

        addingCurrency = true;

        const originalText = button.textContent;

        button.disabled = true;
        button.textContent = 'Menambahkan...';

        const url = addToMasterUrlTemplate.replace(
            '__ISO_ID__',
            encodeURIComponent(currency.id)
        );

        try {
        const csrfToken =
            document.querySelector('meta[name="csrf-token"]')
                ?.getAttribute('content') ||
            document.querySelector('input[name="_token"]')
                ?.value;

            const headers = {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            };

            if (csrfToken) {
                headers['X-CSRF-TOKEN'] = csrfToken;
            }

            const response = await fetch(url, {
                method: 'POST',
                headers: headers,
                credentials: 'same-origin',
                body: JSON.stringify({})
            });

            const payload = await response.json();

            if (!response.ok || !payload.success) {
                throw new Error(
                    payload?.message ||
                    'Currency gagal ditambahkan ke Master.'
                );
            }

            const masterCurrency =
                payload.data?.currency;

            if (!masterCurrency) {
                throw new Error(
                    'Response Master Currency tidak lengkap.'
                );
            }

            /*
             * Update object ISO lokal supaya row berubah
             * dari "Tambah & Pakai" menjadi "Pakai ke Form".
             */
            currency.master_currency = {
                id: masterCurrency.id,
                code: masterCurrency.code,
                name: masterCurrency.name,
                flag: masterCurrency.flag,
                is_active: masterCurrency.is_active
            };

            /*
             * Tambahkan currency baru ke select utama
             * apabila belum ada.
             */
            let option =
                currencyField.querySelector(
                    'option[value="' +
                    masterCurrency.id +
                    '"]'
                );

            if (!option) {
                option = document.createElement('option');
                option.value = String(masterCurrency.id);
                option.textContent =
                    masterCurrency.code +
                    ' — ' +
                    masterCurrency.name;

                currencyField.appendChild(option);
            }

            updateCurrencyForm(currency);

            /*
             * Tutup modal setelah berhasil.
             */
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';

            searchInput.value = '';

            renderList(isoCurrencies);

        } catch (error) {
            console.error('ISO 4217 Add Master:', error);

            button.disabled = false;
            button.textContent = originalText;

            alert(
                error?.message ||
                'Currency gagal ditambahkan ke Master Currency.'
            );
        } finally {
            addingCurrency = false;
        }
    }

    function renderList(items) {
        list.innerHTML = '';

        empty.hidden = items.length !== 0;

        if (!items.length) {
            return;
        }

        const fragment =
            document.createDocumentFragment();

        items.forEach(function (currency) {
            const master =
                currency.master_currency;

            const canUse =
                !!master &&
                master.is_active;

            const needsMaster =
                !master;

            const row =
                document.createElement('div');

            row.className =
                'rates-iso-row';

            row.innerHTML =
                '<div class="rates-iso-main">' +

                    '<div class="rates-iso-code-wrap">' +
                        '<span class="rates-iso-code">' +
                            escapeHtml(currency.code) +
                        '</span>' +

                        (
                            currency.numeric_code
                                ? '<span class="rates-iso-numeric">' +
                                    escapeHtml(
                                        currency.numeric_code
                                    ) +
                                  '</span>'
                                : ''
                        ) +
                    '</div>' +

                    '<div class="rates-iso-name">' +
                        escapeHtml(currency.name) +
                    '</div>' +

                    '<div class="rates-iso-entities">' +
                        '<div class="rates-iso-entities-label">' +
                            'NEGARA / ENTITAS' +
                        '</div>' +

                        getEntityPreview(currency) +
                    '</div>' +

                '</div>' +

                '<div class="rates-iso-action">' +

                    (
                        canUse
                            ? '<button type="button" class="rates-iso-use-button" data-iso-action="use">' +
                                'Pakai ke Form' +
                              '</button>'

                            : needsMaster
                                ? '<button type="button" class="rates-iso-use-button" data-iso-action="add">' +
                                    'Tambah &amp; Pakai' +
                                  '</button>'

                                : '<button type="button" class="rates-iso-use-button" disabled>' +
                                    'Master Nonaktif' +
                                  '</button>'
                    ) +

                '</div>';

            const actionButton =
                row.querySelector(
                    '.rates-iso-use-button'
                );

            if (actionButton && canUse) {
                actionButton.addEventListener(
                    'click',
                    function () {
                        updateCurrencyForm(currency);

                        modal.classList.remove('is-open');
                        modal.setAttribute(
                            'aria-hidden',
                            'true'
                        );

                        document.body.style.overflow = '';

                        searchInput.value = '';

                        renderList(isoCurrencies);
                    }
                );
            }

            if (actionButton && needsMaster) {
                actionButton.addEventListener(
                    'click',
                    function () {
                        addCurrencyToMaster(
                            currency,
                            actionButton
                        );
                    }
                );
            }

            fragment.appendChild(row);
        });

        list.appendChild(fragment);
    }

    function filterCurrencies() {
        const query =
            normalize(
                searchInput.value.trim()
            );

        if (!query) {
            renderList(isoCurrencies);
            return;
        }

        const filtered =
            isoCurrencies.filter(
                function (currency) {
                    const entityText =
                        getEntityText(currency);

                    const haystack =
                        normalize([
                            currency.code,
                            currency.numeric_code,
                            currency.name,
                            entityText
                        ].join(' '));

                    return haystack.includes(query);
                }
            );

        renderList(filtered);
    }

    async function loadCurrencies() {
        if (loaded) {
            renderList(isoCurrencies);
            return;
        }

        if (loadingPromise) {
            await loadingPromise;
            renderList(isoCurrencies);
            return;
        }

        loading.hidden = false;
        empty.hidden = true;
        list.innerHTML = '';

        loadingPromise = fetch(endpoint, {
            method: 'GET',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error(
                        'Gagal memuat data ISO 4217 (' +
                        response.status +
                        ').'
                    );
                }

                return response.json();
            })
            .then(function (payload) {
                if (
                    !payload ||
                    payload.success !== true
                ) {
                    throw new Error(
                        payload?.message ||
                        'Data ISO 4217 tidak tersedia.'
                    );
                }

                isoCurrencies =
                    Array.isArray(payload.data)
                        ? payload.data
                        : [];

                loaded = true;
            })
            .catch(function (error) {
                console.error(
                    'ISO 4217:',
                    error
                );

                list.innerHTML =
                    '<div class="rates-iso-modal-status">' +
                        'Gagal memuat data ISO 4217. Silakan coba lagi.' +
                    '</div>';

                loaded = false;
            })
            .finally(function () {
                loadingPromise = null;
                loading.hidden = true;
            });

        await loadingPromise;

        if (loaded) {
            filterCurrencies();
        }
    }

    function openModal() {
        modal.classList.add('is-open');
        modal.setAttribute(
            'aria-hidden',
            'false'
        );

        document.body.style.overflow =
            'hidden';

        searchInput.value = '';

        loadCurrencies().then(
            function () {
                if (
                    modal.classList.contains(
                        'is-open'
                    )
                ) {
                    searchInput.focus();
                }
            }
        );
    }

    function closeModal() {
        modal.classList.remove('is-open');

        modal.setAttribute(
            'aria-hidden',
            'true'
        );

        document.body.style.overflow = '';
    }

    openButton.addEventListener(
        'click',
        openModal
    );

    closeButton.addEventListener(
        'click',
        closeModal
    );

    if (backdrop) {
        backdrop.addEventListener(
            'click',
            closeModal
        );
    }

    searchInput.addEventListener(
        'input',
        filterCurrencies
    );

    document.addEventListener(
        'keydown',
        function (event) {
            if (
                event.key === 'Escape' &&
                modal.classList.contains(
                    'is-open'
                )
            ) {
                closeModal();
            }
        }
    );
}
