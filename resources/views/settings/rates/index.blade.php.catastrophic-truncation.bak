    padding: 4px 7px;
    border-radius: 4px;
    font-size: 9px;
    font-weight: 900;
}

.rates-variant-badge {
    color: var(--ui-primary);
    background: var(--ui-primary-light);
    border: 1px solid #cfe4d9;
}

.rates-denomination-badge {
    color: var(--ui-gold-dark);
    background: var(--ui-gold-light);
    border: 1px solid #ead8a7;
    font-variant-numeric: tabular-nums;
}

.rates-denomination-general {
    color: var(--ui-text-muted);
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
}


/* =========================================================
   SOURCE
   ========================================================= */

.rates-source-badge {
    display: inline-flex;
    padding: 3px 6px;
    color: var(--ui-primary);
    background: var(--ui-primary-light);
    border: 1px solid #cfe4d9;
    border-radius: 4px;
    font-size: 8px;
    font-weight: 900;
}

.rates-muted {
    color: var(--ui-text-muted);
    font-size: 9px;
}


/* =========================================================
   SPREAD / RATE
   ========================================================= */

.spread-negative {
    color: #a23830;
    font-weight: 900;
}

.spread-positive {
    color: var(--ui-primary);
    font-weight: 900;
}

.rate-result {
    color: var(--ui-text);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
}

.rates-date {
    color: var(--ui-text-secondary);
    font-size: 9px;
}


/* =========================================================
   STATUS
   ========================================================= */

.rates-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 82px;
    padding: 4px 6px;
    border-radius: 4px;
    font-size: 8px;
    font-weight: 900;
}

.rates-status > span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
}

.rates-status.active {
    color: var(--ui-primary);
    background: var(--ui-primary-light);
    border: 1px solid #cfe4d9;
}

.rates-status.active > span {
    background: var(--ui-success);
}

.rates-status.inactive {
    color: var(--ui-text-muted);
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
}

.rates-status.inactive > span {
    background: #9ca3af;
}


/* =========================================================
   ACTION
   ========================================================= */

.rates-action-button {
    width: 27px;
    height: 27px;
    padding: 0;
    color: var(--ui-primary);
    background: #ffffff;
    border: 1px solid var(--ui-border);
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
}

.rates-action-button:hover {
    background: var(--ui-primary-light);
    border-color: var(--ui-primary);
}


/* =========================================================
   EMPTY
   ========================================================= */

.rates-empty {
    padding: 25px !important;
    color: var(--ui-text-muted) !important;
    text-align: center;
}


/* =========================================================
   MASTER SOURCE
   ========================================================= */

.rates-source-form-wrap {
    background: #fbfdfc;
    border-bottom: 1px solid var(--ui-border-light);
}

.rates-source-form {
    padding-bottom: 9px;
}

.rates-checkbox {
    display: inline-flex !important;
    align-items: center;
    gap: 7px;
    height: 32px;
    margin: 0 !important;
    color: var(--ui-text-secondary);
    font-size: 10px !important;
    font-weight: 700 !important;
    cursor: pointer;
}

.rates-checkbox input {
    width: 14px !important;
    height: 14px !important;
    margin: 0;
}

.rates-source-url {
    color: var(--ui-primary);
    font-size: 9px;
    text-decoration: none;
}

.rates-source-url:hover {
    text-decoration: underline;
}

.rates-source-description {
    display: block;
    margin-top: 3px;
    color: var(--ui-text-muted);
    font-size: 8px;
    white-space: normal;
}

.rates-source-actions {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}

.rates-inline-form {
    display: inline;
    margin: 0;
    padding: 0;
}

.rates-source-table {
    min-width: 760px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {

    .rates-form {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}

@media (max-width: 900px) {

    .rates-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .rates-form {
        grid-template-columns: 1fr;
    }

    .rates-source-bar {
        align-items: flex-start;
        flex-direction: column;
        gap: 6px;
    }

    .rates-source-divider {
        display: none;
    }

}

</style>

@endsection


