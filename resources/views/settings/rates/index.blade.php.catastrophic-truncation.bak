                            @endphp

                            @if($denominations->count() > 0)

                                @foreach($denominations as $denomination)

                                    @php
                                        $hasRateRows = true;

                                        $key = $rateKey(
                                            $currency->id,
                                            $variant->id,
                                            $denomination->id
                                        );

                                        $rateCollection = $latestRates->get($key);

                                        $rate = $rateCollection instanceof \Illuminate\Support\Collection
                                            ? $rateCollection->first()
                                            : $rateCollection;
                                    @endphp

