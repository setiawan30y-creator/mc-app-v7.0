@section('page-title', 'Manajemen Kurs')

@section('content')

@php
    $formatRate = function ($value) {
        if ($value === null || $value === '') {
            return '-';
        }

        return rtrim(
            rtrim(number_format((float) $value, 6, ',', '.'), '0'),
            ','
        );
    };

    $rateKey = function ($currencyId, $variantId = null, $denominationId = null) {
        return implode(':', [
            $currencyId,
            $variantId ?? 0,
            $denominationId ?? 0,
        ]);
    };
@endphp

