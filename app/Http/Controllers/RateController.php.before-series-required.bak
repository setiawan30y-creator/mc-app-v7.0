<?php

namespace App\Http\Controllers;

use App\Models\Currency;
use App\Models\CurrencyDenomination;
use App\Models\CurrencyVariant;
use App\Models\RateSnapshot;
use App\Models\RateSource;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\Rule;
use Illuminate\View\View;

class RateController extends Controller
{
    /**
     * Halaman Manajemen Kurs.
     *
     * Struktur kurs:
     *
     * Tenant
     *   └── Currency
     *        └── Variant
     *             └── Denomination
     *
     * Rate aktif dibedakan berdasarkan:
     * tenant + currency + variant + denomination
     */
    public function index(Request $request): View
    {
        $user = $request->user();

        abort_unless($user && $user->tenant_id, 403);

        $currencies = Currency::query()
            ->active()
            ->ordered()
            ->with([
                'variants' => function ($query) {
                    $query
                        ->active()
                        ->ordered()
                        ->with([
                            'denominations' => function ($query) {
                                $query
                                    ->active()
                                    ->ordered();
                            },
                        ]);
                },
            ])
            ->get();

        $sources = RateSource::query()
            ->where('tenant_id', $user->tenant_id)
            ->active()
            ->ordered()
            ->get();

        $allSources = RateSource::query()
            ->where('tenant_id', $user->tenant_id)
            ->orderBy('sort_order')
            ->orderBy('name')
            ->get();

        /*
         * Ambil seluruh rate aktif tenant.
         *
         * Jangan unique berdasarkan currency_id karena:
         *
         * USD 100
         * USD 50
         * USD 10
         *
         * dapat mempunyai rate berbeda.
         */
        $latestRates = RateSnapshot::query()
            ->where('tenant_id', $user->tenant_id)
            ->active()
            ->with([
                'currency',
                'rateSource',
                'variant',
                'denomination',
            ])
            ->orderByDesc('effective_at')
            ->get()
            ->groupBy(function (RateSnapshot $rate) {
                return implode(':', [
                    $rate->currency_id,
                    $rate->currency_variant_id ?? 0,
                    $rate->currency_denomination_id ?? 0,
                ]);
            });

        return view('settings.rates.index', [
            'currencies' => $currencies,
            'sources' => $sources,
            'allSources' => $allSources,
            'latestRates' => $latestRates,
        ]);
    }

    /**
     * Simpan kurs baru.
     */
    public function store(Request $request): RedirectResponse
    {
        $user = $request->user();

        abort_unless($user && $user->tenant_id, 403);

        $validated = $this->validateRate($request, $user->tenant_id);

        $scope = $this->resolveRateScope(
            tenantId: $user->tenant_id,
            currencyId: (int) $validated['currency_id'],
            variantId: $validated['currency_variant_id'] ?? null,
            denominationId: $validated['currency_denomination_id'] ?? null,
        );

        $referenceBuyRate = (float) $validated['reference_buy_rate'];
        $referenceSellRate = (float) $validated['reference_sell_rate'];

        $buySpread = (float) $validated['buy_spread'];
        $sellSpread = (float) $validated['sell_spread'];

        /*
         * Rumus:
         *
         * Kurs Almara Beli
         * = Kurs Acuan Beli + Spread Beli
         *
         * Kurs Almara Jual
         * = Kurs Acuan Jual + Spread Jual
         */
        $buyRate = $referenceBuyRate + $buySpread;
        $sellRate = $referenceSellRate + $sellSpread;

        if ($buyRate < 0 || $sellRate < 0) {
            return back()
                ->withInput()
                ->withErrors([
                    'reference_buy_rate' => 'Hasil kurs beli tidak boleh negatif.',
                    'reference_sell_rate' => 'Hasil kurs jual tidak boleh negatif.',
                ]);
        }

        $rateSource = RateSource::query()
            ->where('tenant_id', $user->tenant_id)
            ->where('id', $validated['rate_source_id'])
            ->where('is_active', true)
            ->firstOrFail();

        DB::transaction(function () use (
            $user,
            $validated,
            $scope,
            $rateSource,
            $referenceBuyRate,
            $referenceSellRate,
            $buySpread,
            $sellSpread,
            $buyRate,
            $sellRate
        ) {
            /*
             * Hanya nonaktifkan rate pada scope yang sama.
             *
             * Contoh:
             *
             * USD 100 tidak boleh menonaktifkan USD 10.
             */
            $this->deactivateActiveRate(
                tenantId: $user->tenant_id,
                currencyId: $scope['currency_id'],
                variantId: $scope['currency_variant_id'],
                denominationId: $scope['currency_denomination_id'],
            );

            RateSnapshot::create([
                'tenant_id' => $user->tenant_id,

                'currency_id' => $scope['currency_id'],
                'currency_variant_id' => $scope['currency_variant_id'],
                'currency_denomination_id' => $scope['currency_denomination_id'],

                'rate_source_id' => $rateSource->id,
                'effective_at' => $validated['effective_at'],

                'reference_buy_rate' => $referenceBuyRate,
                'reference_sell_rate' => $referenceSellRate,

                'buy_spread' => $buySpread,
                'sell_spread' => $sellSpread,

                'buy_rate' => $buyRate,
                'sell_rate' => $sellRate,

                'source_url' => $rateSource->url,
                'notes' => $validated['notes'] ?? null,

                'is_active' => true,
                'created_by' => $user->id,
            ]);
        });

        return redirect()
            ->route('settings.rates.index')
            ->with('success', 'Kurs Almara berhasil disimpan.');
    }

    /**
     * Update kurs.
     *
     * Snapshot lama TIDAK diubah.
     * Sistem membuat snapshot baru.
     */
    public function update(
        Request $request,
        RateSnapshot $rateSnapshot
    ): RedirectResponse {
        $user = $request->user();

        abort_unless($user && $user->tenant_id, 403);

        /*
         * Tenant isolation.
         */
        abort_unless(
            $rateSnapshot->tenant_id === $user->tenant_id,
            404
        );

        $validated = $this->validateRate(
            $request,
            $user->tenant_id
        );

        $scope = $this->resolveRateScope(
            tenantId: $user->tenant_id,
            currencyId: (int) $validated['currency_id'],
            variantId: $validated['currency_variant_id'] ?? null,
            denominationId: $validated['currency_denomination_id'] ?? null,
        );

        $referenceBuyRate = (float) $validated['reference_buy_rate'];
        $referenceSellRate = (float) $validated['reference_sell_rate'];

        $buySpread = (float) $validated['buy_spread'];
        $sellSpread = (float) $validated['sell_spread'];

        $buyRate = $referenceBuyRate + $buySpread;
        $sellRate = $referenceSellRate + $sellSpread;

        if ($buyRate < 0 || $sellRate < 0) {
            return back()
                ->withInput()
                ->withErrors([
                    'reference_buy_rate' => 'Hasil kurs beli tidak boleh negatif.',
                    'reference_sell_rate' => 'Hasil kurs jual tidak boleh negatif.',
                ]);
        }

        $rateSource = RateSource::query()
            ->where('tenant_id', $user->tenant_id)
            ->where('id', $validated['rate_source_id'])
            ->where('is_active', true)
            ->firstOrFail();

        DB::transaction(function () use (
            $user,
            $validated,
            $scope,
            $rateSource,
            $referenceBuyRate,
            $referenceSellRate,
            $buySpread,
            $sellSpread,
            $buyRate,
            $sellRate
        ) {
            $this->deactivateActiveRate(
                tenantId: $user->tenant_id,
                currencyId: $scope['currency_id'],
                variantId: $scope['currency_variant_id'],
                denominationId: $scope['currency_denomination_id'],
            );

            RateSnapshot::create([
                'tenant_id' => $user->tenant_id,

                'currency_id' => $scope['currency_id'],
                'currency_variant_id' => $scope['currency_variant_id'],
                'currency_denomination_id' => $scope['currency_denomination_id'],

                'rate_source_id' => $rateSource->id,
                'effective_at' => $validated['effective_at'],

                'reference_buy_rate' => $referenceBuyRate,
                'reference_sell_rate' => $referenceSellRate,

                'buy_spread' => $buySpread,
                'sell_spread' => $sellSpread,

                'buy_rate' => $buyRate,
                'sell_rate' => $sellRate,

                'source_url' => $rateSource->url,
                'notes' => $validated['notes'] ?? null,

                'is_active' => true,
                'created_by' => $user->id,
            ]);
        });

        return redirect()
            ->route('settings.rates.index')
            ->with('success', 'Kurs Almara berhasil diperbarui.');
    }

    /**
     * Validasi input kurs.
     */
    private function validateRate(
        Request $request,
        string $tenantId
    ): array {
        return $request->validate([
            'currency_id' => [
                'required',
                'integer',
                Rule::exists('currencies', 'id')
                    ->where(function ($query) {
                        $query->where('is_active', true);
                    }),
            ],

            /*
             * Variant boleh kosong.
             *
             * Jika kosong, sistem akan menggunakan
             * variant default dari currency.
             */
            'currency_variant_id' => [
                'nullable',
                'integer',
                Rule::exists('currency_variants', 'id')
                    ->where(function ($query) {
                        $query->where('is_active', true);
                    }),
            ],

            /*
             * Denomination juga boleh kosong.
             *
             * Jika kosong:
             * rate berlaku pada level variant/currency.
             */
            'currency_denomination_id' => [
                'nullable',
                'integer',
                Rule::exists('currency_denominations', 'id')
                    ->where(function ($query) {
                        $query->where('is_active', true);
                    }),
            ],

            'rate_source_id' => [
                'required',
                'integer',
                Rule::exists('rate_sources', 'id')
                    ->where(function ($query) use ($tenantId) {
                        $query
                            ->where('tenant_id', $tenantId)
                            ->where('is_active', true);
                    }),
            ],

            'effective_at' => [
                'required',
                'date',
            ],

            'reference_buy_rate' => [
                'required',
                'numeric',
                'min:0',
            ],

            'reference_sell_rate' => [
                'required',
                'numeric',
                'min:0',
            ],

            'buy_spread' => [
                'required',
                'numeric',
            ],

            'sell_spread' => [
                'required',
                'numeric',
            ],

            'notes' => [
                'nullable',
                'string',
                'max:500',
            ],
        ]);
    }

    /**
     * Tentukan scope kurs.
     *
     * Jika variant tidak dipilih:
     * gunakan variant default.
     *
     * Jika denomination dipilih:
     * denomination harus benar-benar milik
     * variant yang digunakan dan currency yang dipilih.
     */
    private function resolveRateScope(
        string $tenantId,
        int $currencyId,
        ?int $variantId = null,
        ?int $denominationId = null
    ): array {
        /*
         * Pastikan currency aktif.
         */
        $currencyExists = Currency::query()
            ->whereKey($currencyId)
            ->where('is_active', true)
            ->exists();

        abort_unless($currencyExists, 422);

        /*
         * Jika variant tidak dipilih,
         * cari variant default.
         */
        if ($variantId === null) {
            $variant = CurrencyVariant::query()
                ->where('currency_id', $currencyId)
                ->where('is_default', true)
                ->where('is_active', true)
                ->ordered()
                ->first();

            /*
             * Fallback:
             * jika tidak ada variant default,
             * gunakan variant aktif pertama.
             */
            if (! $variant) {
                $variant = CurrencyVariant::query()
                    ->where('currency_id', $currencyId)
                    ->where('is_active', true)
                    ->ordered()
                    ->first();
            }

            abort_unless($variant, 422);

            $variantId = $variant->id;
        } else {
            /*
             * Variant harus milik currency
             * yang sedang diproses.
             */
            $variant = CurrencyVariant::query()
                ->whereKey($variantId)
                ->where('currency_id', $currencyId)
                ->where('is_active', true)
                ->first();

            abort_unless($variant, 422);
        }

        /*
         * Jika denomination dipilih,
         * pastikan denomination:
         *
         * - aktif
         * - milik variant
         * - secara otomatis berarti milik currency
         */
        if ($denominationId !== null) {
            $denomination = CurrencyDenomination::query()
                ->whereKey($denominationId)
                ->where('currency_variant_id', $variantId)
                ->where('is_active', true)
                ->first();

            abort_unless($denomination, 422);
        }

        return [
            'currency_id' => $currencyId,
            'currency_variant_id' => $variantId,
            'currency_denomination_id' => $denominationId,
        ];
    }

    /**
     * Nonaktifkan rate aktif pada scope yang sama.
     *
     * Penting:
     *
     * USD 100
     * USD 50
     * USD 10
     *
     * tidak saling menonaktifkan.
     */
    private function deactivateActiveRate(
        string $tenantId,
        int $currencyId,
        ?int $variantId,
        ?int $denominationId
    ): void {
        $query = RateSnapshot::query()
            ->where('tenant_id', $tenantId)
            ->where('currency_id', $currencyId)
            ->where('is_active', true);

        /*
         * Variant.
         */
        if ($variantId === null) {
            $query->whereNull('currency_variant_id');
        } else {
            $query->where('currency_variant_id', $variantId);
        }

        /*
         * Denomination.
         */
        if ($denominationId === null) {
            $query->whereNull('currency_denomination_id');
        } else {
            $query->where('currency_denomination_id', $denominationId);
        }

        $query->update([
            'is_active' => false,
        ]);
    }

    /**
     * Tambah Master Sumber Kurs.
     */
    public function storeSource(Request $request): RedirectResponse
    {
        $user = $request->user();

        abort_unless($user && $user->tenant_id, 403);

        $validated = $request->validate([
            'name' => [
                'required',
                'string',
                'max:100',
            ],

            'code' => [
                'required',
                'string',
                'max:30',
                'alpha_dash',
            ],

            'type' => [
                'required',
                Rule::in([
                    'reference',
                    'official',
                    'market',
                    'manual',
                    'api',
                ]),
            ],

            'url' => [
                'nullable',
                'url',
                'max:500',
            ],

            'description' => [
                'nullable',
                'string',
            ],

            'sort_order' => [
                'nullable',
                'integer',
                'min:0',
                'max:9999',
            ],
        ]);

        $code = strtoupper(trim($validated['code']));

        $exists = RateSource::query()
            ->where('tenant_id', $user->tenant_id)
            ->where('code', $code)
            ->exists();

        if ($exists) {
            return back()
                ->withInput()
                ->withErrors([
                    'code' => 'Kode sumber kurs tersebut sudah digunakan.',
                ]);
        }

        RateSource::create([
            'tenant_id' => $user->tenant_id,
            'name' => trim($validated['name']),
            'code' => $code,
            'type' => $validated['type'],
            'url' => $validated['url'] ?? null,
            'description' => $validated['description'] ?? null,
            'is_active' => $request->boolean('is_active', true),
            'sort_order' => $validated['sort_order'] ?? 0,
        ]);

        return redirect()
            ->route('settings.rates.index')
            ->with('success', 'Sumber kurs berhasil ditambahkan.');
    }

    /**
     * Update Master Sumber Kurs.
     */
    public function updateSource(
        Request $request,
        RateSource $rateSource
    ): RedirectResponse {
        $user = $request->user();

        abort_unless($user && $user->tenant_id, 403);

        abort_unless(
            $rateSource->tenant_id === $user->tenant_id,
            404
        );

        $validated = $request->validate([
            'name' => [
                'required',
                'string',
                'max:100',
            ],

            'code' => [
                'required',
                'string',
                'max:30',
                'alpha_dash',
            ],

            'type' => [
                'required',
                Rule::in([
                    'reference',
                    'official',
                    'market',
                    'manual',
                    'api',
                ]),
            ],

            'url' => [
                'nullable',
                'url',
                'max:500',
            ],

            'description' => [
                'nullable',
                'string',
            ],

            'sort_order' => [
                'nullable',
                'integer',
                'min:0',
                'max:9999',
            ],
        ]);

        $code = strtoupper(trim($validated['code']));

        $exists = RateSource::query()
            ->where('tenant_id', $user->tenant_id)
            ->where('code', $code)
            ->where('id', '!=', $rateSource->id)
            ->exists();

        if ($exists) {
            return back()
                ->withInput()
                ->withErrors([
                    'code' => 'Kode sumber kurs tersebut sudah digunakan.',
                ]);
        }

        $rateSource->update([
            'name' => trim($validated['name']),
            'code' => $code,
            'type' => $validated['type'],
            'url' => $validated['url'] ?? null,
            'description' => $validated['description'] ?? null,
            'sort_order' => $validated['sort_order'] ?? 0,
        ]);

        return redirect()
            ->route('settings.rates.index')
            ->with('success', 'Sumber kurs berhasil diperbarui.');
    }

    /**
     * Aktif/nonaktifkan Master Sumber Kurs.
     */
    public function toggleSource(
        Request $request,
        RateSource $rateSource
    ): RedirectResponse {
        $user = $request->user();

        abort_unless($user && $user->tenant_id, 403);

        abort_unless(
            $rateSource->tenant_id === $user->tenant_id,
            404
        );

        $rateSource->update([
            'is_active' => ! $rateSource->is_active,
        ]);

        return redirect()
            ->route('settings.rates.index')
            ->with(
                'success',
                $rateSource->is_active
                    ? 'Sumber kurs diaktifkan.'
                    : 'Sumber kurs dinonaktifkan.'
            );
    }
}